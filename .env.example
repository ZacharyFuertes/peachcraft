# Example environment variables for Cloudflare R2 and Supabase

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_BUCKET_NAME=peachcraft-products-pics
CLOUDFLARE_R2_API_TOKEN=your_cloudflare_r2_api_token
# Optional public URL if using a custom domain or if your bucket is exposed differently
# CLOUDFLARE_R2_PUBLIC_URL=https://<account_id>.r2.cloudflarestorage.com/<bucket>

# Supabase (keep these if you still use Supabase for database auth and queries)
VITE_SUPABASE_URL=https://your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ADMIN_EMAIL=admin@example.com

# Cloudflare Turnstile (CAPTCHA alternative for form protection)
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Resend API (optional for direct OTP/signup verification email delivery)
# RESEND_API_KEY=re_your_resend_api_key
# RESEND_FROM_EMAIL=onboarding@resend.dev
